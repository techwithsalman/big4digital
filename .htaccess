# ==========================================================
# BIG4DIGITAL — HOSTINGER PRODUCTION .HTACCESS
# Optimized for LiteSpeed & Apache Web Servers
# ==========================================================

RewriteEngine On

# ----------------------------------------------------------
# 1. HTTPS REDIRECT
# ----------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----------------------------------------------------------
# 1.5 CANONICAL HOMEPAGE REDIRECT (index.html -> /)
# ----------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ----------------------------------------------------------
# 2. CLEAN URLS & EXTENSIONLESS ACCESS (.html)
# ----------------------------------------------------------
# If requesting a directory, serve index.html
DirectoryIndex index.html index.php

# If the request matches a file with .html appended, rewrite internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# ----------------------------------------------------------
# 3. 404 FALLBACK
# ----------------------------------------------------------
ErrorDocument 404 /index.html

# ----------------------------------------------------------
# 4. MIME TYPES
# ----------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/html                          .html .htm
  AddType text/css                           .css
  AddType application/javascript             .js .mjs
  AddType application/json                   .json
  AddType image/svg+xml                      .svg .svgz
  AddType image/webp                         .webp
  AddType image/png                          .png
  AddType image/jpeg                         .jpg .jpeg
  AddType image/x-icon                       .ico
  AddType font/woff                          .woff
  AddType font/woff2                         .woff2
  AddType font/ttf                           .ttf
  AddType font/otf                           .otf
  AddType video/mp4                          .mp4
  AddType video/webm                         .webm
  AddCharset UTF-8                           .html .css .js .json .xml
</IfModule>

# ----------------------------------------------------------
# 5. GZIP / BROTLI COMPRESSION (mod_deflate / LiteSpeed)
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
</IfModule>

# ----------------------------------------------------------
# 6. BROWSER CACHING HEADERS (mod_expires & mod_headers)
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                             "access plus 1 month"

  # HTML: always revalidate to receive latest updates
  ExpiresByType text/html                    "access plus 0 seconds"

  # CSS and JavaScript
  ExpiresByType text/css                     "access plus 1 year"
  ExpiresByType application/javascript       "access plus 1 year"

  # Images & Media
  ExpiresByType image/jpg                    "access plus 1 year"
  ExpiresByType image/jpeg                   "access plus 1 year"
  ExpiresByType image/png                    "access plus 1 year"
  ExpiresByType image/webp                   "access plus 1 year"
  ExpiresByType image/svg+xml                "access plus 1 year"
  ExpiresByType image/x-icon                 "access plus 1 year"
  ExpiresByType video/mp4                    "access plus 1 year"

  # Fonts
  ExpiresByType font/woff                    "access plus 1 year"
  ExpiresByType font/woff2                   "access plus 1 year"
  ExpiresByType font/ttf                     "access plus 1 year"
  ExpiresByType font/otf                     "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTML no-cache header to prevent stale layouts on Hostinger CDN
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache CSS and JS with revalidate
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Cache static assets aggressively
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # --------------------------------------------------------
  # 7. SECURITY HEADERS
  # --------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Disable directory browsing
Options -Indexes
